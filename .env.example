# ============================================================
# Deal Pilot 环境变量模板
# 用法：复制为 .env 后按需填写
#   PowerShell: Copy-Item .env.example .env
# 注意：.env 已在 .gitignore 中，请勿提交真实密钥
# ============================================================

# ---------- 模型接入（必填）----------
# 默认走本项目的 LiteLLM 网关：http://127.0.0.1:4000/v1
#   先在 litellm-config.yaml 里配置模型（或 http://localhost:4000/ui 添加）
#   OPENAI_API_KEY 填 docker-compose.yml 里的 LITELLM_MASTER_KEY
#     也可以在 http://localhost:4000/ui -> Virtual Keys 创建子 Key 来填（可限额、可吊销）
#     注意：UI 的 admin/123456 只是登录账号，不是 API Key
# 可选：直连其他 OpenAI 兼容服务，把 BASE_URL 换成服务商地址、Key 换成服务商 Key
#   例如 DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:4000/v1
# 必须和实际模型名一致（走网关时 = litellm-config.yaml 里的 model_name）
OPENAI_DEFAULT_MODEL=

# ---------- LiteLLM 上游模型 Key（只给网关容器用）----------
# 变量名要和 litellm-config.yaml 里 os.environ/XXX 完全一致
# 这些 Key 由 docker-compose.yml 透传给 litellm 容器，不会传给 Agent 进程
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
UPSTREAM_OPENAI_API_KEY=

# ---------- Nacos 配置中心（Agent 启动必需）----------
# 宿主访问地址；代码会自动去掉结尾的 /
NACOS_SERVER_ADDRESS=http://localhost:8848
# Nacos 3.x 默认命名空间
NACOS_NAMESPACE_ID=public
# 首次登录 http://localhost:8080 时设置的账号密码
NACOS_USERNAME=nacos
NACOS_PASSWORD=
# 配置缓存时间（秒）
NACOS_TTL=5

# ---------- Milvus（RAG 索引链路使用）----------
MILVUS_URI=http://127.0.0.1:19530
MILVUS_DB_NAME=deal_pilot

# ---------- 共享 MinIO（Agent 产物 / 沙箱文件）----------
# 与 docker-compose.yml 中 shared-minio 的默认值保持一致
MINIO_ACCESS_KEY=root
MINIO_SECRET_KEY=12345678
MINIO_ENDPOINT=localhost:9002
MINIO_SECURE=false
# 沙箱容器内访问宿主机 MinIO 的地址
MINIO_ENDPOINT_IN_SANDBOX=host.docker.internal:9002

# ---------- OpenSandbox 沙箱 ----------
OPEN_SANDBOX_DOMAIN=127.0.0.1:8090
# 本地开发占位密钥，需与 docker compose 读取到的同一个变量一致
# 如果要暴露到局域网，请换成长随机串
OPEN_SANDBOX_API_KEY=deal-pilot-local-sandbox-key

# ---------- Langfuse 可观测（不填会缺少 trace）----------
# 在 http://localhost:3000 注册后，进入项目 Settings -> API Keys 获取
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
# Trace 保留天数，定时清理图会用到
LANGFUSE_TRACE_RETENTION_DAYS=1
# 实验 / 告警 Webhook 签名密钥，不填则相关接口返回 503
LANGFUSE_EXPERIMENT_WEBHOOK_SECRET=
LANGFUSE_ALERT_WEBHOOK_SECRET=

# ---------- 飞书（仅 feishu_doc_index 图需要）----------
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ---------- Tavily（web_search 工具）----------
TAVILY_API_KEY=

# ---------- LangSmith（可选，仅调试用）----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deal-pilot

# ---------- Benchmark（可选）----------
BENCHMARK_AGENT_SERVER=http://localhost:2024
BENCHMARK_USER_ID=test_user
BENCHMARK_GRAPH_ID=main_agent

# ============================================================
# 以下变量由 docker compose 读取，不是应用代码使用
# ============================================================

# Langfuse Webhook 允许访问的宿主地址
LANGFUSE_WEBHOOK_WHITELISTED_HOST=host.docker.internal

# Langfuse 事务邮件（可选）
LANGFUSE_SMTP_CONNECTION_URL=
LANGFUSE_EMAIL_FROM_ADDRESS=

# Langfuse Ask AI（可选，复用上面的模型配置）
LANGFUSE_OPENAI_API_KEY=${OPENAI_API_KEY}
LANGFUSE_OPENAI_BASE_URL=${OPENAI_BASE_URL}
LANGFUSE_OPENAI_DEFAULT_MODEL=${OPENAI_DEFAULT_MODEL}
